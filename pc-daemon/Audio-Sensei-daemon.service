[Unit]
Description=Serial Audio Controller daemon
After=network.target sound.target

[Service]
Type=simple

WorkingDirectory=%h/.local/share/Audio-Sensei-daemon
Environment="PYTHONUNBUFFERED=1"
ExecStart=%h/.local/share/Audio-Sensei-daemon/.venv/bin/python %h/.local/share/Audio-Sensei-daemon/main.py --mapping %h/.config/Audio-Sensei-daemon/mapping.json --config %h/.config/Audio-Sensei-daemon/config.toml

Restart=always
RestartSec=5

[Install]
WantedBy=default.target